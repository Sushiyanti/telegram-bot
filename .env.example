# Copy to .env for local development and replace the placeholders.
# Never commit .env or paste a live token into source files.
BOT_TOKEN=replace_with_botfather_token
STORAGE_CHANNEL_ID=replace_with_private_channel_numeric_id
ADMIN_IDS=replace_with_numeric_telegram_user_id
UPLOADER_MODE=admin
UPLOADER_IDS=
UPLOADER_REDEEM_CODE=
# Deprecated: offer-level channel/group requirements are authoritative.
REQUIRED_CHANNEL_ID=
# Optional one-time import of REQUIRED_CHANNEL_ID into every active offer.
LEGACY_CHANNEL_IMPORT_ENABLED=false
# Leave unset until copy-to-recipient size support has been verified.
VERIFIED_TRANSFER_MAX_FILE_BYTES=
DB_PATH=./data/bot.db
LOG_LEVEL=INFO
ENV=dev
MAX_RELAY_FILE_BYTES=2147483648
DEFAULT_PROTECT_CONTENT=false
