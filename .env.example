# Copy to .env for local development and replace the placeholders.
# Never commit .env or paste a live token into source files.
BOT_TOKEN=replace_with_botfather_token
STORAGE_CHANNEL_ID=replace_with_private_channel_numeric_id
ADMIN_IDS=replace_with_numeric_telegram_user_id
UPLOADER_MODE=admin
UPLOADER_IDS=replace_with_numeric_telegram_user_id
DB_PATH=./data/bot.db
LOG_LEVEL=INFO
ENV=dev
MAX_RELAY_FILE_BYTES=2147483648
DEFAULT_PROTECT_CONTENT=false
