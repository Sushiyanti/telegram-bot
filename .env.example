ADMIN_IDS=replace_with_numeric_telegram_user_id
STORAGE_CHAT_ID=replace_with_private_channel_numeric_id
DATABASE_PATH=./data/bot.sqlite3
LOG_LEVEL=INFO
DEFAULT_PROTECT_CONTENT=false
